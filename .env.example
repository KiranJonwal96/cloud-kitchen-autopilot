# Copy this file to .env and fill in your key. Never commit .env (it is in .gitignore).

# ---- Required: OpenAI ---------------------------------------------------------
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
# Only if your key comes from a course platform (e.g. a Vocareum key starting with "voc-"):
# OPENAI_BASE_URL=https://openai.vocareum.com/v1
# openai = AI agents; none = the same workflow with rule-based agents (no key needed)
LLM_PROVIDER=openai

# ---- Live data (used by default) ------------------------------------------
# Real weather from Open-Meteo (free, no key). Set your kitchen's location.
WEATHER_SOURCE=open_meteo            # or: simulated
KITCHEN_LATITUDE=12.9716
KITCHEN_LONGITUDE=77.5946
# Real holidays and festivals from Calendarific (free key at calendarific.com)
HOLIDAY_SOURCE=calendarific          # or: simulated
CALENDARIFIC_API_KEY=
HOLIDAY_COUNTRY=IN
# HOLIDAY_LOCATION=in-ka             # optional: a state, for state holidays

# ---- Optional: LangSmith tracing (see every agent, tool and LLM call) ---------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=cloud-kitchen-autopilot

# ---- Optional: password for the whole site (set both when deployed publicly) --
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# ---- Optional tuning (defaults shown) -----------------------------------------
# CONFIDENCE_THRESHOLD=0.6        # escalate forecasts below this confidence
# SPIKE_RATIO=1.3                 # forecast / normal ratio that counts as a spike
# MAX_SPEND_PER_PO=25000          # policy limit per purchase order (INR)
# DAILY_PROCUREMENT_BUDGET=60000  # policy limit per day (INR)
# RAG_TOP_K=4                     # procedures retrieved per question
# RAG_MIN_SCORE=0.25              # minimum match score for a procedure
# APP_PORT=8000
